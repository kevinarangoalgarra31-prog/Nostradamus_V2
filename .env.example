# Variables de entorno requeridas para el proyecto
# Copia este archivo, renómbralo a .env y reemplaza los valores con tus llaves reales.

# Llave de la API de Groq (Gratuita en console.groq.com)
GROQ_API_KEY=gsk_aqui_va_tu_llave_larga

# Opcional: Modelo de Groq a utilizar por defecto
GROQ_MODEL=qwen/qwen3.8-27b

# Opcional: noticias históricas para el MCP de investigación
NEWSAPI_KEY=newsapi_aqui_va_tu_llave

# Opcional: aumenta la cuota del proveedor de referencia CoinGecko
COINGECKO_API_KEY=coingecko_aqui_va_tu_llave

# Opcional: identifica responsablemente las consultas públicas a Crossref
CROSSREF_MAILTO=correo_academico@example.com
