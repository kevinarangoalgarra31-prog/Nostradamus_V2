# Variables de entorno requeridas para el proyecto
# Copia este archivo, renómbralo a .env y reemplaza los valores con tus llaves reales.

# Llave de la API de Groq (Gratuita en console.groq.com)
GROQ_API_KEY=gsk_aqui_va_tu_llave_larga

# Opcional: Modelo de Groq a utilizar por defecto
GROQ_MODEL=qwen/qwen3.8-27b

